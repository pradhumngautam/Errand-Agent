# Live demo only: add ONE API key. Tests and evals run offline and need no key.
#
# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=

# or OpenRouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.6-flash
# OPENROUTER_MAX_TOKENS=2048

# Optional: force a provider (gemini | openrouter | claude_cli).
# Unset: OpenRouter if its key is set, else Gemini if its key is set, else claude_cli.
# LLM_PROVIDER=

# claude_cli: no-key fallback using a locally installed, signed-in `claude` CLI
# CLAUDE_CLI_MODEL=haiku
# CLAUDE_CLI_PATH=
# CLAUDE_CLI_TIMEOUT=120
