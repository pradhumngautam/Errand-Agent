# Live demo only. Tests and evals run offline with a scripted model and need no key.
#
# Model provider: claude_cli | openrouter | gemini
# Unset: OpenRouter if its key is set, else Gemini if its key is set, else claude_cli.
LLM_PROVIDER=

# claude_cli: a locally installed, signed-in `claude` CLI (no API key)
CLAUDE_CLI_MODEL=haiku
# CLAUDE_CLI_PATH=
# CLAUDE_CLI_TIMEOUT=120

# openrouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.6-flash
# OPENROUTER_MAX_TOKENS=2048

# gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=
